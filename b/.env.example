# PostgreSQL (setup_databases.bat ile lforadio veritabanı oluşturulduktan sonra)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=lforadio

# Opsiyonel: tek satırda
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/lforadio

# İlk yönetici (mevcut üyelik hesabının e-posta adresi)
INITIAL_ADMIN_EMAIL=info@lowradio.com

# SoundCloud Artist Pro hesabından oluşturulan API uygulaması.
# Boş bırakılırsa panel içi arama kapanır; URL doğrulama/önizleme çalışmaya devam eder.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
